# copy this file to backend/.env and fill in your own values
# the real .env must never be committed

# postgres connection string
# format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
# if the password has special characters (@ # / %) url-encode them, e.g. @ becomes %40
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/lirs_register

# secret used to sign every JWT, make it long and random, generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# frontend addresses allowed to call this api, comma separated
CORS_ORIGINS=http://localhost:5173
