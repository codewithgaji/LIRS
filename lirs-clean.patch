-CREATE TABLE public.profiles (
-  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
-  user_id uuid UNIQUE,
-  full_name text NOT NULL,
-  email text NOT NULL UNIQUE,
-  intended_role public.app_role NOT NULL DEFAULT 'account_officer',
