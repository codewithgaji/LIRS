-    await supabaseAdmin
-      .from("user_roles")
-      .upsert({ user_id: userId, role: data.role }, { onConflict: "user_id,role" });
-
-    return { ok: true };
-  });
-
-/** Changes a staff member's role (profile + user_roles stay in sync). */
